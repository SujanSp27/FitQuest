# RapidAPI Key for ExerciseDB (optional - fallback data will be used if not provided)
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Get your free API key from https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# 3. Replace 'your_rapidapi_key_here' with your actual API key
# 4. The app will work without this key using fallback data